<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TweakOne.ViewModels"
        mc:Ignorable="d"
        x:Class="TweakOne.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Icon="/Assets/AppIcon.png"
        Title="{Binding Strings.WindowTitle}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto,*" Margin="16">
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12">
            <Button Content="{Binding Strings.OpenSourcePackageButton}" Click="OpenSourceDocument_Click" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SourceFilePathDisplay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,12">
            <Button Content="{Binding Strings.OpenTargetPackageButton}" Click="OpenTargetDocument_Click" />
            <Button Content="{Binding Strings.SaveTargetPackageButton}" Click="SaveTargetDocument_Click" />
            <TextBlock VerticalAlignment="Center" Text="{Binding TargetFilePathDisplay}" />
        </StackPanel>

        <TabControl Grid.Row="2" Grid.ColumnSpan="3">
            <TabItem Header="{Binding Strings.CloneTabHeader}">
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
                            <TextBlock Text="{Binding Strings.SourceFieldHeader}" FontSize="18" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding SourcePartfields}"
                                      SelectedItem="{Binding SelectedSourcePartfield}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartfieldViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" Classes="hint" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{Binding SelectedSourcePartfieldSummaryDisplay}" />

                            <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="12">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Strings.PreviewZoomLabel}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.5" Maximum="8" Value="{Binding CloneSourcePreviewZoom}" TickFrequency="0.25" />
                                        <TextBlock Grid.Column="2" Text="{Binding CloneSourcePreviewZoomDisplay}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{Binding Strings.PreviewResetZoomButton}" Click="ResetCloneSourcePreviewZoom_Click" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="4" Width="328" Height="328" ClipToBounds="True">
                                        <Grid x:Name="CloneSourcePreviewViewport"
                                              Background="Transparent"
                                              PointerPressed="CloneSourcePreview_PointerPressed"
                                              PointerMoved="CloneSourcePreview_PointerMoved"
                                              PointerReleased="CloneSourcePreview_PointerReleased"
                                              PointerCaptureLost="PreviewViewport_PointerCaptureLost"
                                              PointerWheelChanged="CloneSourcePreview_PointerWheelChanged">
                                            <ItemsControl ItemsSource="{Binding CloneSourcePreviewShapes}" Width="{Binding CloneSourcePreviewCanvasSize}" Height="{Binding CloneSourcePreviewCanvasSize}" IsHitTestVisible="False">
                                                <ItemsControl.RenderTransform>
                                                    <TranslateTransform X="{Binding CloneSourcePreviewOffsetX}" Y="{Binding CloneSourcePreviewOffsetY}" />
                                                </ItemsControl.RenderTransform>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewPolylineViewModel">
                                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Text="{Binding Strings.GuidanceLinesHeader}" FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SelectedSourcePartfield.GuidancePaths}"
                                             SelectedItem="{Binding SelectedSourceGuidancePath}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuidancePathViewModel">
                                                <StackPanel Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="{Binding Strings.SourceGuidanceHint}" Foreground="Gray" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0" Width="240">
                        <StackPanel VerticalAlignment="Center" Spacing="12">
                            <Button Content="{Binding Strings.UseSourceAsTargetButton}" Click="UseSourceAsTarget_Click" IsEnabled="{Binding CanUseSourceAsTarget}" />
                            <TextBlock Text="{Binding Strings.CloneControlsHeader}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Strings.CloneDesignatorLabel}" />
                            <TextBox Text="{Binding CloneDesignator}" Watermark="{Binding Strings.CloneDesignatorWatermark}" />
                            <TextBlock Text="{Binding Strings.TranslationOffsetMetersLabel}" />
                            <TextBox Text="{Binding TranslationOffsetMeters}" />
                            <Button Content="{Binding Strings.CloneAsIsButton}" Click="CloneSimple_Click" IsEnabled="{Binding CanCloneGuidancePath}" />
                            <Button Content="{Binding Strings.CloneWithAutoTranslationButton}" Click="CloneTranslated_Click" IsEnabled="{Binding CanCloneGuidancePath}" />
                            <Button Content="{Binding Strings.DeleteSelectedTargetGuidanceButton}" Click="DeleteSelectedTargetGuidance_Click" IsEnabled="{Binding CanDeleteTargetGuidancePath}" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="{Binding Strings.AutoTranslationDescription}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
                            <TextBlock Text="{Binding Strings.TargetFieldHeader}" FontSize="18" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding TargetPartfields}"
                                      SelectedItem="{Binding SelectedTargetPartfield}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartfieldViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" Classes="hint" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{Binding SelectedTargetPartfieldSummaryDisplay}" />

                            <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="12">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Strings.PreviewZoomLabel}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.5" Maximum="8" Value="{Binding CloneTargetPreviewZoom}" TickFrequency="0.25" />
                                        <TextBlock Grid.Column="2" Text="{Binding CloneTargetPreviewZoomDisplay}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{Binding Strings.PreviewResetZoomButton}" Click="ResetCloneTargetPreviewZoom_Click" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="4" Width="328" Height="328" ClipToBounds="True">
                                        <Grid x:Name="CloneTargetPreviewViewport"
                                              Background="Transparent"
                                              PointerPressed="CloneTargetPreview_PointerPressed"
                                              PointerMoved="CloneTargetPreview_PointerMoved"
                                              PointerReleased="CloneTargetPreview_PointerReleased"
                                              PointerCaptureLost="PreviewViewport_PointerCaptureLost"
                                              PointerWheelChanged="CloneTargetPreview_PointerWheelChanged">
                                            <ItemsControl ItemsSource="{Binding CloneTargetPreviewShapes}" Width="{Binding CloneTargetPreviewCanvasSize}" Height="{Binding CloneTargetPreviewCanvasSize}" IsHitTestVisible="False">
                                                <ItemsControl.RenderTransform>
                                                    <TranslateTransform X="{Binding CloneTargetPreviewOffsetX}" Y="{Binding CloneTargetPreviewOffsetY}" />
                                                </ItemsControl.RenderTransform>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewPolylineViewModel">
                                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Text="{Binding Strings.TargetGuidanceLinesHeader}" FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SelectedTargetPartfield.GuidancePaths}"
                                             SelectedItem="{Binding SelectedTargetGuidancePath}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuidancePathViewModel">
                                                <StackPanel Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="{Binding Strings.TargetGuidanceHint}" Foreground="Gray" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Strings.RectificationTabHeader}">
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
                            <TextBlock Text="{Binding Strings.SourceFieldHeader}" FontSize="18" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding SourcePartfields}"
                                      SelectedItem="{Binding SelectedSourcePartfield}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartfieldViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" Classes="hint" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{Binding SelectedSourcePartfieldSummaryDisplay}" />

                            <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="12">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Strings.PreviewZoomLabel}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.5" Maximum="8" Value="{Binding RectificationSourcePreviewZoom}" TickFrequency="0.25" />
                                        <TextBlock Grid.Column="2" Text="{Binding RectificationSourcePreviewZoomDisplay}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{Binding Strings.PreviewResetZoomButton}" Click="ResetRectificationSourcePreviewZoom_Click" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="4" Width="328" Height="328" ClipToBounds="True">
                                        <Grid x:Name="RectificationSourcePreviewViewport"
                                              Background="Transparent"
                                              PointerPressed="RectificationSourcePreview_PointerPressed"
                                              PointerMoved="RectificationSourcePreview_PointerMoved"
                                              PointerReleased="RectificationSourcePreview_PointerReleased"
                                              PointerCaptureLost="PreviewViewport_PointerCaptureLost"
                                              PointerWheelChanged="RectificationSourcePreview_PointerWheelChanged">
                                            <ItemsControl ItemsSource="{Binding RectificationSourcePreviewShapes}" Width="{Binding RectificationSourcePreviewCanvasSize}" Height="{Binding RectificationSourcePreviewCanvasSize}" IsHitTestVisible="False">
                                                <ItemsControl.RenderTransform>
                                                    <TranslateTransform X="{Binding RectificationSourcePreviewOffsetX}" Y="{Binding RectificationSourcePreviewOffsetY}" />
                                                </ItemsControl.RenderTransform>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewPolylineViewModel">
                                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Text="{Binding Strings.GuidanceLinesHeader}" FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SelectedSourcePartfield.GuidancePaths}"
                                             SelectedItem="{Binding SelectedRectificationSourceGuidancePath}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuidancePathViewModel">
                                                <StackPanel Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="{Binding Strings.RectificationDescription}" Foreground="Gray" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0" Width="280">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding Strings.RectificationControlsHeader}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Strings.RectificationDesignatorLabel}" />
                                <TextBox Text="{Binding RectificationDesignator}" Watermark="{Binding Strings.RectificationDesignatorWatermark}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Strings.RectificationOffsetMetersLabel}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding RectificationOffsetMeters}" Width="60" HorizontalContentAlignment="Right" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Strings.RectificationRowCountLabel}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding RectificationRowCount}" Width="60" HorizontalContentAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Strings.RectificationApplicationOffsetMetersLabel}" />
                                <TextBlock Text="{Binding RectificationApplicationOffsetDisplay}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Strings.RectificationToleranceMetersLabel}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding RectificationToleranceMeters}" Width="60" HorizontalContentAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Strings.RectificationPassModeLabel}" />
                                <StackPanel Spacing="6">
                                    <RadioButton Content="{Binding Strings.RectificationPassModeAutomaticLabel}"
                                                 GroupName="RectificationPassMode"
                                                 IsChecked="{Binding IsRectificationPassModeAutomatic}" />
                                    <RadioButton Content="{Binding Strings.RectificationPassModeManualLabel}"
                                                 GroupName="RectificationPassMode"
                                                 IsChecked="{Binding IsRectificationPassModeManual}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Strings.RectificationManualPassCountLabel}"
                                           IsEnabled="{Binding IsRectificationManualPassCountEnabled}" />
                                <ComboBox ItemsSource="{Binding RectificationManualPassCounts}"
                                          SelectedItem="{Binding RectificationManualPassCount}"
                                          IsEnabled="{Binding IsRectificationManualPassCountEnabled}" />
                                <TextBlock Text="{Binding Strings.RectificationAutomaticPassCountLabel}"
                                           IsVisible="{Binding IsRectificationAutomaticPassCountVisible}" />
                                <TextBlock Text="{Binding RectificationAutomaticPassCountDisplay}"
                                           IsVisible="{Binding IsRectificationAutomaticPassCountVisible}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Strings.RectificationToleranceGuidance}"
                                           IsVisible="{Binding IsRectificationAutomaticPassCountVisible}"
                                           Foreground="Gray"
                                           TextWrapping="Wrap" />
                                <Button Content="{Binding Strings.AnalyzeRectificationButton}" Click="AnalyzeRectification_Click" IsEnabled="{Binding CanAnalyzeRectification}" />
                                <Button Content="{Binding Strings.ApplyRectifiedGuidanceButton}" Click="ApplyRectification_Click" IsEnabled="{Binding CanApplyRectification}" />
                                <TextBlock Text="{Binding Strings.RectificationResultHeader}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding RectificationResultDisplay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
                            <StackPanel Spacing="8">
                                <Button Content="{Binding Strings.UseSourceAsTargetButton}" Click="UseSourceAsTarget_Click" IsEnabled="{Binding CanUseSourceAsTarget}" />
                                <TextBlock Text="{Binding Strings.TargetFieldHeader}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding TargetPartfields}"
                                      SelectedItem="{Binding SelectedTargetPartfield}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartfieldViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" Classes="hint" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{Binding SelectedTargetPartfieldSummaryDisplay}" />

                            <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="12">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Strings.PreviewZoomLabel}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.5" Maximum="8" Value="{Binding RectificationTargetPreviewZoom}" TickFrequency="0.25" />
                                        <TextBlock Grid.Column="2" Text="{Binding RectificationTargetPreviewZoomDisplay}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{Binding Strings.PreviewResetZoomButton}" Click="ResetRectificationTargetPreviewZoom_Click" />
                                    </Grid>
                                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="4" Width="328" Height="328" ClipToBounds="True">
                                        <Grid x:Name="RectificationTargetPreviewViewport"
                                              Background="Transparent"
                                              PointerPressed="RectificationTargetPreview_PointerPressed"
                                              PointerMoved="RectificationTargetPreview_PointerMoved"
                                              PointerReleased="RectificationTargetPreview_PointerReleased"
                                              PointerCaptureLost="PreviewViewport_PointerCaptureLost"
                                              PointerWheelChanged="RectificationTargetPreview_PointerWheelChanged">
                                            <ItemsControl ItemsSource="{Binding RectificationTargetPreviewShapes}" Width="{Binding RectificationTargetPreviewCanvasSize}" Height="{Binding RectificationTargetPreviewCanvasSize}" IsHitTestVisible="False">
                                                <ItemsControl.RenderTransform>
                                                    <TranslateTransform X="{Binding RectificationTargetPreviewOffsetX}" Y="{Binding RectificationTargetPreviewOffsetY}" />
                                                </ItemsControl.RenderTransform>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewPolylineViewModel">
                                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Text="{Binding Strings.TargetGuidanceLinesHeader}" FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SelectedTargetPartfield.GuidancePaths}"
                                             SelectedItem="{Binding SelectedTargetGuidancePath}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuidancePathViewModel">
                                                <StackPanel Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="{Binding Strings.RectificationPreviewHint}" Foreground="Gray" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="12" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
